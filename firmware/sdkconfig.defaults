CONFIG_IDF_TARGET="esp32"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=4096
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
# Enabled for the provisioning setup AP (see nexus_wifi.c) — a probe spends
# almost all its life in station mode; AP mode is only used for the brief,
# time-boxed setup window when no working WiFi credentials are stored yet.
